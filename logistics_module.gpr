project Logistics_Module is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022", "-gnata");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

end Logistics_Module;
